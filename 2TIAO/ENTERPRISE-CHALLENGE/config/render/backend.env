# ═════════════════════════════════════════════════════════════════════════════
# Genera Intelligence — Backend Environment Template (Render)
#
# This file is a TEMPLATE for environment variables used by the backend service
# when deployed on Render.
#
# ⚠️ DO NOT COMMIT SECRETS TO THIS FILE
# Instead, set these variables on the Render dashboard:
#   1. Go to your service settings
#   2. Click "Environment"
#   3. Add each secret as a new environment variable
#   4. Render will inject them at runtime
#
# VARIABLES MARKED [SECRET] must be set on Render dashboard.
# VARIABLES MARKED [OPTIONAL] can be left empty (uses provider default).
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Provider Selection
# ─────────────────────────────────────────────────────────────────────────────

# Primary LLM provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# LLM model override (optional). Empty = use provider default
# - Gemini default: gemini-3.1-flash-lite
# - OpenAI default: gpt-4o
LLM_MODEL=

# Embeddings provider: "gemini" or "openai"
# ⚠️ IMPORTANT: Changing this requires regenerating FAISS index via `make seed`
EMBEDDINGS_PROVIDER=gemini

# Embeddings model override (optional)
# - Gemini default: models/gemini-embedding-001
# - OpenAI default: text-embedding-3-large
EMBEDDINGS_MODEL=

# Judge provider for eval (LLM-as-a-Judge)
# Empty = use same provider as LLM_PROVIDER
JUDGE_PROVIDER=

# Judge model override (optional)
JUDGE_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# Google Gemini API [SECRET]
# ─────────────────────────────────────────────────────────────────────────────

# Your Google Gemini API key (from https://aistudio.google.com/apikey)
# ⚠️ Set on Render dashboard, NOT here
GOOGLE_API_KEY=your_google_api_key_here

# Model names (if overriding defaults)
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI API [SECRET, OPTIONAL]
# ─────────────────────────────────────────────────────────────────────────────

# Your OpenAI API key (from https://platform.openai.com/account/api-keys)
# ⚠️ Only set if LLM_PROVIDER=openai or EMBEDDINGS_PROVIDER=openai
# ⚠️ Set on Render dashboard, NOT here
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model names (required if using OpenAI provider)
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ─────────────────────────────────────────────────────────────────────────────
# LLM Parameters
# ─────────────────────────────────────────────────────────────────────────────

# Temperature: 0.0–1.0 (controls randomness)
# 0.0 = deterministic, 1.0 = creative
# Default: 0.3 (slightly creative, grounded in facts)
LLM_TEMPERATURE=0.3

# Max tokens per LLM response
LLM_MAX_TOKENS=2048

# ─────────────────────────────────────────────────────────────────────────────
# Chat Endpoint Parameters
# ─────────────────────────────────────────────────────────────────────────────

# Max tokens for resumido (brief) mode
CHAT_MAX_TOKENS_RESUMIDO=400

# Max tokens for detalhado (detailed) mode
CHAT_MAX_TOKENS_DETALHADO=1200

# Max words for resumido mode (soft limit, for response planning)
CHAT_MAX_PALAVRAS_RESUMIDO=120

# ─────────────────────────────────────────────────────────────────────────────
# RAG (Retrieval-Augmented Generation)
# ─────────────────────────────────────────────────────────────────────────────

# Number of documents to retrieve from FAISS for each query
RETRIEVER_K=3

# ─────────────────────────────────────────────────────────────────────────────
# OCR (Document Extraction via ETL)
# ─────────────────────────────────────────────────────────────────────────────

# OCR Provider: "paddle_local" or "textract"
# - paddle_local: Uses PaddleOCR service on port 8100 (local Docker container on Render)
# - textract: Uses AWS Textract (requires AWS credentials below)
OCR_PROVIDER=paddle_local

# Bearer token for /api/ocr/ endpoint authentication
# ⚠️ Set on Render dashboard, NOT here
OCR_TOKEN=your_ocr_bearer_token_here

# AWS Textract configuration [SECRET, OPTIONAL]
# ⚠️ Only required if OCR_PROVIDER=textract
# ⚠️ Set on Render dashboard if needed

# AWS region where Textract is deployed
TEXTRACT_REGION=us-east-1

# AWS access key ID
# ⚠️ Set on Render dashboard, NOT here
AWS_ACCESS_KEY_ID=

# AWS secret access key
# ⚠️ Set on Render dashboard, NOT here
AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Persistence Layer (History Store & Database)
# ─────────────────────────────────────────────────────────────────────────────

# Database type: "sqlite" or "postgres"
# - sqlite: Embedded database (no external dependency, persists to /app/data/history.db)
# - postgres: PostgreSQL (requires DATABASE_URL and Render PostgreSQL add-on)
DB_TYPE=sqlite

# PostgreSQL connection string [OPTIONAL]
# ⚠️ Only used if DB_TYPE=postgres
# Format: postgresql://user:password@host:port/database_name
# Example: postgresql://genera:secure_password@dpg-abc123.render.com:5432/genera_prod
# To get this value:
#   1. Add Postgres add-on to genera-backend service on Render dashboard
#   2. Render auto-generates DATABASE_URL; copy it from the environment variables section
# ⚠️ Set on Render dashboard, NOT here
DATABASE_URL=

# SQLite database path [OPTIONAL]
# Only used if DB_TYPE=sqlite
# Default: /app/data/history.db (relative to backend working directory)
# On Render, this path persists to the "genera-data" disk
GENERA_DB_PATH=/app/data/history.db

# ─────────────────────────────────────────────────────────────────────────────
# Paths (Data, Vector Store, Database)
# ─────────────────────────────────────────────────────────────────────────────

# Path to genetic report data (JSON) for FAISS seeding
# On Render, copied from repo root to container during build
GENERA_DATA_PATH=/data/proposta_estrutura_de_dados.json

# Path to FAISS index directory
# On Render, persists to the "genera-data" disk
GENERA_FAISS_PATH=/app/faiss_index

# ═════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT INSTRUCTIONS
# ═════════════════════════════════════════════════════════════════════════════
#
# 1. Go to your Render service dashboard: https://render.com/dashboard
# 2. Click on genera-backend
# 3. Click "Environment" (or "Settings" → "Environment")
# 4. Set the following [SECRET] variables:
#    - GOOGLE_API_KEY: Paste your Google Gemini API key
#    - OPENAI_API_KEY: (only if using OpenAI) paste your OpenAI API key
#    - OCR_TOKEN: Set a strong bearer token for /api/ocr/ authentication
#    - AWS_ACCESS_KEY_ID: (only if OCR_PROVIDER=textract)
#    - AWS_SECRET_ACCESS_KEY: (only if OCR_PROVIDER=textract)
#    - DATABASE_URL: (only if DB_TYPE=postgres) copy from Postgres add-on
#
# 5. For [OPTIONAL] variables, adjust as needed per your deployment.
#
# 6. If using PostgreSQL:
#    a. Click "Settings" → "Add-ons"
#    b. Click "Create add-on" → "PostgreSQL"
#    c. Render auto-generates DATABASE_URL; copy it to Environment
#    d. Set DB_TYPE=postgres
#
# 7. Save and deploy. Render will rebuild and restart the service.
#
# ═════════════════════════════════════════════════════════════════════════════
