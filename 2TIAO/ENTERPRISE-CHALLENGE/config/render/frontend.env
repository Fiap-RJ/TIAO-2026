# ═════════════════════════════════════════════════════════════════════════════
# Genera Intelligence — Frontend Environment Template (Render)
#
# This file is a TEMPLATE for environment variables used by the frontend (React)
# when deployed on Render.
#
# The frontend is built at container build time (not runtime), so these variables
# are baked into the compiled React app. To change them, rebuild the container.
#
# For development (local Docker), add these to src/frontend/.env
# For Render deployment, set them on the Render dashboard for genera-frontend service.
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Backend API URL
# ─────────────────────────────────────────────────────────────────────────────

# Backend service URL for API calls
# 
# On Render:
#   - If frontend is in the same Render project, use internal DNS:
#     http://genera-backend:8000
#   - If frontend needs to call backend from browser, use the backend's external Render URL:
#     https://genera-backend.onrender.com
#   - For relative paths (both frontend and backend on same domain):
#     Leave empty and use /api/ paths in React code (configured in nginx.conf)
#
# Render sets RENDER_EXTERNAL_URL; frontend can construct the URL dynamically.
# For now, use relative paths (simplest approach for same-domain setup).

# Build-time variable: Set API_URL during `npm run build`
# If using nginx reverse proxy (src/frontend/nginx.conf), leave empty
API_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Build Mode
# ─────────────────────────────────────────────────────────────────────────────

# Node environment for React build
NODE_ENV=production

# ═════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT INSTRUCTIONS
# ═════════════════════════════════════════════════════════════════════════════
#
# 1. Frontend is built at container build time (not runtime)
#    Changes to this file require a rebuild on Render.
#
# 2. For local Docker development:
#    - Copy this file to src/frontend/.env
#    - Run `docker-compose build frontend`
#
# 3. For Render deployment:
#    a. Go to https://render.com/dashboard
#    b. Click on genera-frontend service
#    c. Click "Settings" → "Environment"
#    d. Add any variables from this file
#    e. Save and trigger a new deploy (e.g., via GitHub push)
#
# 4. Frontend and backend communication:
#    - Frontend (React) makes requests to /api/chat, /api/ocr, etc.
#    - nginx.conf (in frontend container) reverse-proxies /api/* to backend:8000
#    - This works on Render if both services are in the same project
#    - For cross-project or cross-region setup, update nginx.conf with full backend URL
#
# ═════════════════════════════════════════════════════════════════════════════
