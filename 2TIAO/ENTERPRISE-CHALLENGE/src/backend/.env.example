# ═══════════════════════════════════════════
# Genera Intelligence — Variáveis de Ambiente
# ═══════════════════════════════════════════

# ─── Providers e modelos ─────────────────
# Provider: "gemini" ou "openai". Geração, embeddings e juiz são independentes.
# Modelo vazio = usa o modelo do provider (GEMINI_* / OPENAI_* abaixo).
LLM_PROVIDER=gemini
LLM_MODEL=
# O índice FAISS depende de EMBEDDINGS_PROVIDER/EMBEDDINGS_MODEL
# (GENERA_FAISS_PATH/<slug>/demo/) — trocar exige `make seed`.
EMBEDDINGS_PROVIDER=gemini
EMBEDDINGS_MODEL=
# Juiz do eval (LLM-as-a-Judge). JUDGE_PROVIDER vazio = mesmo provider do LLM;
# JUDGE_MODEL vazio = modelo do provider do juiz.
JUDGE_PROVIDER=
JUDGE_MODEL=

# ─── Google Gemini ────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ─── OpenAI ──────────────────────────────
# Obrigatórios se usar o provider openai (o grupo define os IDs; não há default).
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# ─── Parâmetros do LLM ───────────────────
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ─── Chat: limites por nível de detalhe ──
CHAT_MAX_TOKENS_RESUMIDO=400
CHAT_MAX_TOKENS_DETALHADO=1200
CHAT_MAX_PALAVRAS_RESUMIDO=120

# ─── RAG ─────────────────────────────────
RETRIEVER_K=3

# ─── OCR (ETL) ───────────────────────────
# Provider: 'paddle_local' (HTTP client to localhost:8100) or 'textract' (AWS)
# Default: 'paddle_local'
OCR_PROVIDER=paddle_local

# Bearer token for /api/ocr/ endpoint authentication (required for requests)
OCR_TOKEN=test

# AWS Textract configuration (only used if OCR_PROVIDER=textract)
TEXTRACT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
