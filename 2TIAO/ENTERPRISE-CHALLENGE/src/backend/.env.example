# ═══════════════════════════════════════════
# Genera Intelligence — Variáveis de Ambiente
# ═══════════════════════════════════════════

# ─── Providers e modelos ─────────────────────────────────────────
# O sistema suporta múltiplos providers de LLM, embeddings e juiz.
# Cada um é selecionável independentemente via env vars.

# Provider de geração: "gemini" ou "openai"
LLM_PROVIDER=gemini
# Modelo específico do LLM (vazio = usa default do provider)
LLM_MODEL=

# Provider de embeddings: "gemini" ou "openai"
# Nota: alterar este valor invalida o índice FAISS existente;
# execute `make seed` após mudar.
EMBEDDINGS_PROVIDER=gemini
# Modelo específico de embeddings (vazio = usa default do provider)
EMBEDDINGS_MODEL=

# Provider do juiz (LLM-as-a-Judge para eval)
# Vazio = usa mesmo provider do LLM_PROVIDER
JUDGE_PROVIDER=
# Modelo do juiz (vazio = usa default do JUDGE_PROVIDER)
JUDGE_MODEL=

# ─── Google Gemini ───────────────────────────────────────────────
# Obrigatório se LLM_PROVIDER=gemini ou EMBEDDINGS_PROVIDER=gemini
GOOGLE_API_KEY=your_google_api_key_here
# Modelo Gemini de geração (usado se LLM_PROVIDER=gemini e LLM_MODEL vazio)
GEMINI_MODEL=gemini-3.1-flash-lite
# Modelo Gemini de embeddings
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ─── OpenAI ──────────────────────────────────────────────────────
# Obrigatório se LLM_PROVIDER=openai ou EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
# Modelo OpenAI de geração (usado se LLM_PROVIDER=openai e LLM_MODEL vazio)
OPENAI_MODEL=gpt-4o-mini
# Modelo OpenAI de embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Parâmetros do LLM ───────────────────────────────────────────
# Temperatura controla a aleatoriedade: 0.0 = determinístico, 1.0 = criativo
LLM_TEMPERATURE=0.3
# Máximo de tokens por resposta
LLM_MAX_TOKENS=2048

# ─── Chat: limites por nível de detalhe ──────────────────────────
# Limite de tokens para modo "resumido" (respostas curtas e simples)
CHAT_MAX_TOKENS_RESUMIDO=400
# Limite de tokens para modo "detalhado" (respostas completas)
CHAT_MAX_TOKENS_DETALHADO=1200
# Limite de palavras para modo "resumido"
CHAT_MAX_PALAVRAS_RESUMIDO=120

# ─── RAG ──────────────────────────────────────────────────────────
# Número de documentos (chunks) recuperados do FAISS por query
RETRIEVER_K=3

# ─── OCR (ETL) ────────────────────────────────────────────────────
# Provider de OCR para processamento de documentos:
#   - 'paddle_local': HTTP client conectando a localhost:8100 (container local/Render)
#   - 'textract': AWS Textract (requer AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY)
OCR_PROVIDER=paddle_local

# Bearer token para autenticação do endpoint POST /api/ocr/
# Gere um valor aleatório seguro (ex: openssl rand -hex 32)
OCR_TOKEN=test_token_change_in_production

# Configuração AWS Textract (ignorada se OCR_PROVIDER != textract)
# Região AWS para Textract
TEXTRACT_REGION=us-east-1
# ID da chave de acesso AWS
AWS_ACCESS_KEY_ID=
# Chave secreta AWS
AWS_SECRET_ACCESS_KEY=

# ─── Persistência: Camada de Dados ─────────────────────────────────
# Tipo de banco de dados para histórico de interações:
#   - 'sqlite' (padrão): arquivo local, sem dependências externas
#   - 'postgres': PostgreSQL gerenciado (requer DATABASE_URL)
DB_TYPE=sqlite

# Connection string do PostgreSQL (apenas se DB_TYPE=postgres)
# Exemplo: postgresql://user:password@db.render.com:5432/genera_prod
# Deixe vazio para usar SQLite (DB_TYPE=sqlite)
DATABASE_URL=

# Caminho do arquivo SQLite (apenas se DB_TYPE=sqlite)
# Padrão: src/backend/data/history.db (relativo à raiz do workspace)
# Não é versionado (veja .gitignore)
GENERA_DB_PATH=data/history.db

# ─── Caminhos de Dados ──────────────────────────────────────────────
# Caminho do arquivo JSON estruturado com dados genéticos
# Padrão: proposta_estrutura_de_dados.json (raiz do EC)
GENERA_DATA_PATH=proposta_estrutura_de_dados.json

# Diretório do índice FAISS (gerado automaticamente por services/vector_store.py)
# Padrão: faiss_index/
GENERA_FAISS_PATH=faiss_index/
