# CardioIA Fase 6 — copie para src/.env e preencha (src/.env é ignorado pelo Git).
# Variáveis ausentes usam os padrões indicados.

# Obrigatória no modo com LLM (sem ela, use: python main.py --sem-llm)
OPENAI_API_KEY=sua_chave_openai_aqui

# Modelo usado por todos os agentes
OPENAI_MODEL=gpt-4.1-mini

# Temperatura (0 a 2). Deixe vazio para não enviar o parâmetro
OPENAI_TEMPERATURE=0

# Limite de turnos do Runner.run
MAX_TURNS=12

# Artefato do modelo (metadados = mesmo nome com .metadata.json); relativo à raiz da fase
MODELO_PATH=models/modelo_pico_risco.joblib

# Histórico das conversas (SQLiteSession); relativo à raiz da fase
SESSIONS_DB_PATH=data/sessoes.db

# Tracing remoto do SDK (true/false). Desligado por padrão, por privacidade
TRACING_HABILITADO=false

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
