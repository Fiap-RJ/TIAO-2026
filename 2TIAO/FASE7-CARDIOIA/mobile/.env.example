# CardioIA Mobile — copie para .env (ignorado pelo Git) para rodar com `npx expo start`.
# No build do APK (EAS), estes valores vêm do perfil `preview` em eas.json.

# URL pública do backend integrador (sem barra no final).
# Vazia: o app usa o modo demonstração, com dados simulados no aparelho.
EXPO_PUBLIC_API_URL=https://cardioia-backend-phkq.onrender.com

# true força o modo demonstração mesmo com a URL preenchida.
EXPO_PUBLIC_USE_MOCK=false
