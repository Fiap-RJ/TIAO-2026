# CardioIA Web — copie para .env.local (ignorado pelo Git) ou cadastre no painel da Vercel.

# URL pública do backend integrador (sem barra no final).
# Vazia: o front usa o modo demonstração, com dados simulados no navegador.
VITE_API_URL=

# true força o modo demonstração mesmo com VITE_API_URL preenchida.
VITE_USE_MOCK=false
